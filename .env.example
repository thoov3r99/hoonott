# Postgres (auto-injected by the Vercel Neon Marketplace integration in deployed envs)
DATABASE_URL=

# Auth.js — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (resend.com → API Keys; verify hoonott.com as sending domain)
RESEND_API_KEY=
EMAIL_FROM=HooNott Portal <noreply@hoonott.com>

# Admin (hardcoded, non-transferable)
ADMIN_EMAIL=thoover231@gmail.com
